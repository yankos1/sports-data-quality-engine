# Environment variables and secrets
.env
.env.*
!.env.example

# Python virtual environments
venv/
.venv/
env/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/

# Type-checker and linter caches
.mypy_cache/
.ruff_cache/
.pyright/

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Data files and generated reports
data/raw/*.json
!data/raw/.gitkeep
data/reports/*.xlsx
!data/reports/.gitkeep
data/golden/*.csv
!data/golden/.gitkeep

# Playwright artifacts
test-results/
.playwright/